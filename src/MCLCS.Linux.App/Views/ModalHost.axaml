<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MCLCS.Linux.App.Controls"
             x:Class="MCLCS.Linux.App.Views.ModalHost">
  <Grid x:Name="Root" IsVisible="False">
    <!-- 遮罩：点击空白关闭（对齐设计稿 scrimIn 150ms 淡入）-->
    <Border x:Name="Scrim" Background="{DynamicResource ScrimBrush}" PointerPressed="Scrim_PointerPressed">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}"/>
        </Transitions>
      </Border.Transitions>
    </Border>

    <!-- 模态卡片（对齐设计稿 .modal：control-bg / 圆角14 / padding22 / max-width560 / 深阴影）-->
    <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource ControlBackground}"
            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
            CornerRadius="14" Padding="22" MaxWidth="560" MaxHeight="600"
            BoxShadow="{DynamicResource ModalShadow}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{StaticResource MotionNormal}"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionNormal}"/>
        </Transitions>
      </Border.Transitions>
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12"
              IsVisible="{Binding CurrentDialog.Title, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding CurrentDialog.Title}" FontSize="16" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryForeground}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="modal-close" Click="CloseBtn_Click">
            <Button.Content><controls:PngIcon Token="close" IconSize="12"/></Button.Content>
          </Button>
        </Grid>
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding CurrentDialog.Buttons}" Margin="0,18,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="modal-btn" Content="{Binding Text}"
                      Loaded="DialogButton_Loaded" Click="DialogButton_Click"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl x:Name="Body" Content="{Binding CurrentDialog.Content}"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
