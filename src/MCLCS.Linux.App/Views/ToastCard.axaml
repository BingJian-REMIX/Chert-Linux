<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MCLCS.Linux.App.Controls"
             x:Class="MCLCS.Linux.App.Views.ToastCard">
  <Border Classes="toast-card"
          Background="{DynamicResource ControlBackground}"
          BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
          CornerRadius="8" BoxShadow="{DynamicResource ToastShadow}">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{StaticResource MotionNormal}"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionNormal}"/>
      </Transitions>
    </Border.Transitions>
    <DockPanel LastChildFill="True">
      <Rectangle x:Name="Bar" DockPanel.Dock="Left" Width="4" Fill="{DynamicResource AccentBrush}"/>
      <Button DockPanel.Dock="Right" Classes="toast-close" Click="Close_Click">
        <Button.Content><controls:PngIcon Token="close" IconSize="12"/></Button.Content>
      </Button>
      <StackPanel Margin="12,10,8,10">
        <TextBlock Text="{Binding Options.Title}" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryForeground}"/>
        <TextBlock Text="{Binding Options.Message}" FontSize="12"
                   Foreground="{DynamicResource SecondaryForeground}" Margin="0,3,0,0"
                   IsVisible="{Binding Options.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <Button Classes="toast-action" Content="{Binding Options.ActionText}"
                IsVisible="{Binding Options.ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Click="Action_Click"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
