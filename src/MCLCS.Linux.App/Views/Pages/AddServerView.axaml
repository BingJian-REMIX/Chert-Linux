<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.AddServerView"
             x:DataType="vm:AddServerViewModel">
  <!-- 复用全局模态弹窗样式类（modalOverlay 半透明遮罩 + modalCard 卡片），与 WPF/UpdateDialog 视觉一致 -->
  <Grid Classes="modalOverlay">
    <Border Classes="modalCard" MaxWidth="440"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Margin="16">
        <TextBlock Text="服务器名称" FontWeight="Bold" Margin="0,0,0,4"
                   Foreground="{DynamicResource PrimaryForeground}"/>
        <TextBox Text="{Binding Name}" Padding="8,5"
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                 BorderBrush="{DynamicResource InputBorder}"/>

        <TextBlock Text="服务器地址（IP:端口）" FontWeight="Bold" Margin="0,12,0,4"
                   Foreground="{DynamicResource PrimaryForeground}"/>
        <TextBox Text="{Binding Address}" Padding="8,5"
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                 BorderBrush="{DynamicResource InputBorder}"/>

        <TextBlock Text="{Binding Error}" Foreground="#E74C3C" FontSize="12" Margin="0,8,0,0"
                   TextWrapping="Wrap" IsVisible="{Binding HasError}"/>

        <StackPanel Classes="modalBtnRow">
          <Button Content="取消" Width="72" Padding="0,4" Margin="0,0,8,0"
                  Command="{Binding CancelCommand}"/>
          <Button Content="确定" Width="72" Padding="0,4"
                  Classes="primary"
                  Command="{Binding OkCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
