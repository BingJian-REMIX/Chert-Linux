<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.CrashView">
  <UserControl.Resources>
    <conv:BoolToVisibleConverter x:Key="BoolToVis"/>
    <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
  </UserControl.Resources>
  <ScrollViewer Margin="18">
    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="刷新" Command="{Binding RefreshCommand}"/>
          <Button Content="分析" Command="{Binding AnalyzeCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}"/>
        <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                 Background="{DynamicResource InputBackground}" MaxHeight="200">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource FileName}}"
                         FontFamily="Consolas,Monospace" FontSize="12" VerticalAlignment="Center"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <StackPanel Spacing="10" IsVisible="{Binding Analysis, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Padding="8,2" CornerRadius="6" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="{Binding Analysis.Category}" Foreground="#FFFFFF" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="{Binding Analysis.ExceptionType}" VerticalAlignment="Center"
                     FontFamily="Consolas,Monospace" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
        </StackPanel>

        <TextBlock Text="{Binding Analysis.Summary}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryForeground}"/>

        <TextBlock Text="可能原因" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
        <ItemsControl ItemsSource="{Binding Analysis.Causes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="修复建议" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
        <ItemsControl ItemsSource="{Binding Analysis.Suggestions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="原始报告" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
        <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="8" MaxHeight="260">
          <ScrollViewer>
            <TextBlock Text="{Binding ReportText}" FontFamily="Consolas,Monospace" FontSize="11"
                       Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <!-- 聊天记录提取（从最新日志里剥离出聊天行，便于存档 / 复盘） -->
      <StackPanel Spacing="10">
        <TextBlock Text="聊天记录提取" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryForeground}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="提取聊天记录" Command="{Binding ExtractChatCommand}"/>
          <Button Content="导出 txt" Command="{Binding ExportChatCommand}" CommandParameter="txt"
                  IsEnabled="{Binding HasChat}"/>
          <Button Content="导出 md" Command="{Binding ExportChatCommand}" CommandParameter="md"
                  IsEnabled="{Binding HasChat}"/>
        </StackPanel>
        <TextBlock Text="{Binding ChatStatus}" FontSize="12" Foreground="{DynamicResource SecondaryForeground}"
                   TextWrapping="Wrap"/>
        <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="8" MaxHeight="220"
                IsVisible="{Binding HasChat}">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ChatEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,2" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource SecondaryForeground}">
                    <Run Text="{Binding Time}" FontFamily="Consolas,Monospace"/>
                    <Run Text=" "/>
                    <Run Text="{Binding Player}" FontWeight="SemiBold"/>
                    <Run Text="："/>
                    <Run Text="{Binding Message}"/>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <!-- 自动修复方案面板 -->
      <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16"
              IsVisible="{Binding CanRepair, Converter={StaticResource BoolToVis}}">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding RepairTitle}" FontWeight="Bold" FontSize="15"
                     Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock Text="{Binding RepairDescription}" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryForeground}"/>

          <StackPanel Spacing="6">
            <TextBlock Text="操作步骤" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
            <ItemsControl ItemsSource="{Binding RepairSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"
                             Foreground="{DynamicResource SecondaryForeground}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 冲突 Mod：保留哪一个 -->
          <StackPanel Spacing="6" IsVisible="{Binding IsConflictPlan, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="冲突 Mod：选择要保留的一个（其余将重命名为 .disabled）"
                       FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
            <ItemsControl ItemsSource="{Binding ConflictingMods}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="keepmod"
                               Content="{Binding Name}"
                               IsChecked="{Binding IsKeepSelected, Mode=TwoWay}"
                               Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 缺失前置 Mod -->
          <StackPanel Spacing="6" IsVisible="{Binding IsMissingDepPlan, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="缺失的前置依赖（将自动从 Modrinth 安装）"
                       FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
            <ItemsControl ItemsSource="{Binding MissingDependencies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"
                             Foreground="{DynamicResource SecondaryForeground}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="{Binding NonDestructiveNote}" TextWrapping="Wrap"
                     Foreground="{DynamicResource AccentBrush}"
                     IsVisible="{Binding NonDestructiveNote, Converter={StaticResource NonEmptyToVis}}"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="尝试自动修复" Command="{Binding TryRepairCommand}"
                    IsEnabled="{Binding RepairInProgress, Converter={x:Static BoolConverters.Not}}"/>
            <TextBlock Text="修复中…" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"
                       IsVisible="{Binding RepairInProgress, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 降级联动恢复面板 -->
      <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16"
              IsVisible="{Binding HasDowngradeRecovery, Converter={StaticResource BoolToVis}}">
        <StackPanel Spacing="12">
          <TextBlock Text="降级联动恢复" FontWeight="Bold" FontSize="15"
                     Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock Text="{Binding DowngradeRecoveryReason}" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryForeground}"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="回滚到降级前备份"
                    Command="{Binding DowngradeRecoveryCommand}"
                    CommandParameter="RevertBackup"
                    IsEnabled="{Binding RepairInProgress, Converter={x:Static BoolConverters.Not}}"/>
            <Button Content="改用其他降级方式"
                    Command="{Binding DowngradeRecoveryCommand}"
                    CommandParameter="RetryOther"
                    IsEnabled="{Binding RepairInProgress, Converter={x:Static BoolConverters.Not}}"/>
            <Button Content="安装存档原始版本"
                    Command="{Binding DowngradeRecoveryCommand}"
                    CommandParameter="InstallOriginal"
                    IsEnabled="{Binding RepairInProgress, Converter={x:Static BoolConverters.Not}}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding RepairStatus}" TextWrapping="Wrap"
                 Foreground="{DynamicResource SecondaryForeground}"
                 IsVisible="{Binding RepairStatus, Converter={StaticResource NonEmptyToVis}}"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
