<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.AccountsView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Left">

      <StackPanel Spacing="12">
        <TextBlock Text="双击账号即可设为当前账号（多角色切换最常用）"
                   FontSize="11" Opacity="0.7" Foreground="{DynamicResource SecondaryForeground}"/>
        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                 MaxHeight="260" Background="{DynamicResource InputBackground}"
                 DoubleTapped="AccountList_DoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <!-- 两行式（对齐 WPF）：上行角色名、下行「登录方式 · 服务器」。
                     原先单行只显示 DisplayName + 英文技术词（authlib / offline），
                     多角色时完全分不清谁是谁。 -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryForeground}"/>
                  <TextBlock Text="{Binding SubtitleText}" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Content="删除"
                        Command="{Binding Path=DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding NewUsername}" Watermark="离线账号昵称"
                   MinWidth="220" VerticalAlignment="Center"/>
          <Button Content="添加离线账号" Command="{Binding AddOfflineCommand}" Classes="modal-btn primary"/>
        </StackPanel>

        <StackPanel Spacing="8" Margin="0,6,0,0">
          <Button Content="登录微软账号" Command="{Binding LoginMicrosoftCommand}"
                  IsEnabled="{Binding !IsMsBusy}" Classes="modal-btn"/>
          <TextBlock Text="{Binding MsMessage}"
                     IsVisible="{Binding MsMessage, Converter={StaticResource NonEmptyToVis}}"
                     Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
          <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsMsBusy}"/>
        </StackPanel>

        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
