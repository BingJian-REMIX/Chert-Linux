<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.AiAssistView"
             x:DataType="vm:AiAssistViewModel">
  <UserControl.Resources>
    <conv:BoolToVisibleConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
  </UserControl.Resources>

  <DockPanel Margin="18" LastChildFill="True">

    <!-- 标题 -->
    <TextBlock DockPanel.Dock="Top" Text="AI 助手" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

    <!-- 底部：快捷操作 + 输入 + 发送 -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="modal-btn" Content="崩溃分析" Command="{Binding CrashCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Classes="modal-btn" Content="Mod 翻译" Command="{Binding TranslateCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Classes="modal-btn" Content="配装推荐" Command="{Binding RecommendCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Classes="modal-btn" Content="年度总结" Command="{Binding SummaryCommand}" IsEnabled="{Binding !IsBusy}"/>
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding InputText}" AcceptsReturn="True" Margin="0,0,8,0"
                 MinHeight="44" MaxHeight="120" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 Watermark="输入你的问题…（可粘贴崩溃日志）"
                 Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
        <Button Grid.Column="1" Classes="modal-btn primary" Content="发送" MinWidth="72"
                Command="{Binding SendCommand}" IsEnabled="{Binding !IsBusy}" VerticalAlignment="Bottom"
                Height="44" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
      </Grid>
      <TextBlock Classes="status" Text="{Binding StatusMessage}"/>
    </StackPanel>

    <!-- 对话区 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,4,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChatMessage">
            <Grid Margin="0,6,0,0">

              <!-- 用户气泡（右对齐）-->
              <Border IsVisible="{Binding IsUser, Converter={StaticResource BoolToVis}}"
                      Background="{DynamicResource AccentBrush}" CornerRadius="12,12,4,12"
                      Padding="10,8" MaxWidth="560" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Content}" Foreground="White" TextWrapping="Wrap" FontSize="13"/>
              </Border>

              <!-- 助手气泡（左对齐 + 头像）-->
              <StackPanel Orientation="Horizontal" Spacing="8"
                          IsVisible="{Binding IsUser, Converter={StaticResource InvBoolToVis}}"
                          MaxWidth="640" HorizontalAlignment="Left">
                <Border Width="30" Height="30" CornerRadius="15"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                        x:CompileBindings="False">
                  <Grid>
                    <!-- 品牌 logo：白色圆形衬底确保在暗色主题下也能看清深色 favicon -->
                    <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#FFFFFF"
                            IsVisible="{Binding HasLogo, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                      <Image Source="{Binding AssistantLogo, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                             Stretch="Uniform" Margin="2"/>
                    </Border>
                    <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding HasLogo, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}}"/>
                  </Grid>
                </Border>
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="12,12,12,4"
                        Padding="10,8" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                  <TextBlock Text="{Binding Content}" Foreground="{DynamicResource PrimaryForeground}"
                             TextWrapping="Wrap" FontSize="13"/>
                </Border>
              </StackPanel>

            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>
</UserControl>
