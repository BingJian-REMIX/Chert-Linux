<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.GameHomeView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Left">

      <!-- 快速启动面板 -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="快速启动" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>

          <StackPanel Spacing="10">
            <!-- 版本 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="版本" Width="72" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
              <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                        HorizontalAlignment="Stretch" MinWidth="320">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Display}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- 账户 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="账户" Width="72" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
              <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                        HorizontalAlignment="Stretch" MinWidth="320">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding DisplayName}"/>
                      <TextBlock Text="{Binding SubtitleText}" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- 内存 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="内存(MB)" Width="72" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
              <NumericUpDown Value="{Binding MemoryMb}" Minimum="512" Maximum="16384"
                             Increment="256" Width="200"/>
            </StackPanel>

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="启动游戏" Command="{Binding LaunchCommand}"
                      IsEnabled="{Binding CanLaunch}" Classes="modal-btn primary"/>
              <Button Content="刷新版本" Command="{Binding RefreshVersionsCommand}"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 局域网游戏 -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="局域网游戏" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
          <Button Content="刷新" Command="{Binding RefreshLanCommand}" Classes="modal-btn ghost sm"/>
        </StackPanel>
        <TextBlock Text="{Binding LanStatus}" Foreground="{DynamicResource SecondaryForeground}" FontSize="12"/>
        <!-- 横向滚动：卡片流必须可横向滚动，否则窄窗口下内容直接溢出裁掉（对齐 WPF GameView 横向卡片流） -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding LanServers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Width="230" Height="96">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Motd}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Endpoint}" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                    <Button Content="加入" HorizontalAlignment="Right" Classes="modal-btn primary sm"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- 服务器列表 -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="服务器列表" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
          <Button Content="刷新" Command="{Binding RefreshServersCommand}" Classes="modal-btn ghost sm"/>
        </StackPanel>
        <!-- 横向滚动：卡片流必须可横向滚动，否则窄窗口下内容直接溢出裁掉（对齐 WPF GameView 横向卡片流） -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Servers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Width="240" Height="96">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Address}" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                    <Button Content="加入" HorizontalAlignment="Right" Classes="modal-btn primary sm"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- 智能推荐 -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="智能推荐" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
          <Button Content="刷新推荐" Command="{Binding RefreshRecommendCommand}" Classes="modal-btn ghost sm"/>
        </StackPanel>
        <TextBlock Text="{Binding RecommendStatus}" Foreground="{DynamicResource SecondaryForeground}" FontSize="12"/>
        <!-- 横向滚动：卡片流必须可横向滚动，否则窄窗口下内容直接溢出裁掉（对齐 WPF GameView 横向卡片流） -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Recommendations}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Width="250" Height="140">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryForeground}" FontSize="11" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                    <Button Content="一键安装" HorizontalAlignment="Right" Classes="modal-btn primary sm"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- 统计 -->
      <StackPanel Spacing="8">
        <TextBlock Text="统计" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Classes="card" Width="180" Height="80">
            <StackPanel Spacing="4">
              <TextBlock Text="最近版本" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
              <TextBlock Text="{Binding RecentVersionText}" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
          </Border>
          <Border Classes="card" Width="180" Height="80">
            <StackPanel Spacing="4">
              <TextBlock Text="本周时长" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
              <TextBlock Text="{Binding WeeklyPlayText}" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
          </Border>
          <Border Classes="card" Width="180" Height="80">
            <StackPanel Spacing="4">
              <TextBlock Text="崩溃次数（年）" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
              <TextBlock Text="{Binding CrashCountText}" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
