<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.FileWatchView"
             x:DataType="vm:FileWatchViewModel">
  <UserControl.Resources>
    <conv:FileChangeKindToTextConverter x:Key="FileChangeKindToText"/>
    <conv:FileChangeKindToBrushConverter x:Key="FileChangeKindToBrush"/>
    <conv:CountToVisibleConverter x:Key="CountToVisible"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
  </UserControl.Resources>
  <ScrollViewer Margin="18">
    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="modal-btn primary" Content="重新扫描" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left"/>
        <Button Classes="modal-btn ghost" Content="标记为已知" Command="{Binding ResetBaselineCommand}"
                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left"/>
        <ToggleSwitch IsChecked="{Binding FileWatchEnabled}" Content="{Binding Source='tool.filewatch', Converter={StaticResource KeyToText}}"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="未确认的变更（mods / resourcepacks / shaderpacks）" FontWeight="Bold" FontSize="14"/>
        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

        <ItemsControl ItemsSource="{Binding Changes}" IsVisible="{Binding Changes.Count, Converter={StaticResource CountToVisible}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="10,8" Background="{DynamicResource CardBackground}" CornerRadius="6">
                <Grid ColumnDefinitions="56,*,Auto">
                  <Border Grid.Column="0" Padding="6,2" CornerRadius="6" VerticalAlignment="Center"
                          Background="{Binding Kind, Converter={StaticResource FileChangeKindToBrush}}" Width="48">
                    <TextBlock Text="{Binding Kind, Converter={StaticResource FileChangeKindToText}}"
                               Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Path}" VerticalAlignment="Center"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="{Binding Detail}" VerticalAlignment="Center"
                             FontSize="11" Foreground="{DynamicResource SecondaryForeground}" MaxWidth="260" TextWrapping="Wrap"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="没有未确认的变更" IsVisible="{Binding Changes.Count, Converter={StaticResource InvBoolToVis}}"
                   Foreground="{DynamicResource SecondaryForeground}" FontSize="12"/>
      </StackPanel>

      <TextBlock Classes="status" Text="{Binding Status}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
