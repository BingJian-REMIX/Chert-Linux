<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             xmlns:controls="clr-namespace:MCLCS.Linux.App.Controls"
             x:Class="MCLCS.Linux.App.Views.Pages.MusicView">
  <UserControl.Resources>
    <conv:BoolToVisibleConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <conv:PlayPauseGlyphConverter x:Key="PlayPauseGlyph"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.musicBtn">
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">

      <!-- 音源切换 -->
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="音源：" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
        <Button Content="本地文件夹" Command="{Binding SetSourceCommand}" CommandParameter="Local"
                Classes="modal-btn"/>
        <!-- 在线音源：未启用时干脆不给入口，免得用户点进去必然失败 -->
        <Button Content="在线" Command="{Binding SetSourceCommand}" CommandParameter="Online"
                Classes="modal-btn"
                IsVisible="{Binding ApiEnabled, Converter={StaticResource BoolToVis}}"/>
        <Button Content="MC 原声" Command="{Binding SetSourceCommand}" CommandParameter="McOst"
                Classes="modal-btn"/>
        <!-- 本地客户端模式（当遥控器）：总开关关闭时隐藏入口，用户不会点到注定被拒的模式 -->
        <Button Content="本地客户端" Command="{Binding SetSourceCommand}" CommandParameter="Client"
                Classes="modal-btn"
                IsVisible="{Binding ClientModeAvailable}"/>
      </StackPanel>

      <!-- 当前曲目 + 传输控制 -->
      <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
              BorderThickness="1" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding CurrentTrackDisplay}" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock FontSize="11" Opacity="0.85" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource SecondaryForeground}"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="musicBtn" Command="{Binding PreviousCommand}" ToolTip.Tip="上一首">
              <controls:PngIcon Token="previous" IconSize="16"/>
            </Button>
            <Button Classes="musicBtn" Command="{Binding PlayPauseCommand}"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                    ToolTip.Tip="播放 / 暂停">
              <!-- 播放/暂停双图标叠放，按 IsPlaying 切换（等价 WPF 的 Style+DataTrigger 换 Token） -->
              <Panel>
                <controls:PngIcon Token="play" IconSize="18" IsVisible="{Binding !IsPlaying}"/>
                <controls:PngIcon Token="pause" IconSize="18" IsVisible="{Binding IsPlaying}"/>
              </Panel>
            </Button>
            <Button Classes="musicBtn" Command="{Binding NextCommand}" ToolTip.Tip="下一首">
              <controls:PngIcon Token="next" IconSize="16"/>
            </Button>
            <Button Classes="musicBtn" Command="{Binding SetModeCommand}" ToolTip.Tip="{Binding ModeText}">
              <controls:PngIcon Token="menu-unfold" IconSize="16"/>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="6">
              <controls:PngIcon Token="mic" IconSize="16" VerticalAlignment="Center"/>
              <Slider Minimum="0" Maximum="100" Width="140" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Volume, Mode=OneWay, StringFormat='{}{0}%'}" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>
          </StackPanel>
          <ToggleSwitch IsChecked="{Binding AutoDuck}" Content="游戏内语音/音效时自动降低音乐音量"
                        HorizontalAlignment="Left" OffContent="" OnContent=""/>

          <!-- 播放进度：位置 / 拖拽跳转 / 总时长。时长未知（在线流媒体）时禁用。 -->
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="11" Margin="0,0,8,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="1"
                    Value="{Binding ProgressRatio, Mode=TwoWay}"
                    IsEnabled="{Binding HasProgress}"
                    PointerPressed="Seek_PointerPressed"
                    PointerReleased="Seek_PointerReleased"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" Margin="8,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 歌词区：行数随「歌词固定方式」变化，逐行淡入淡出 + 轻微上移（对齐 WPF LyricBox） -->
      <Border MinHeight="64" Padding="14,10" CornerRadius="8"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
              IsVisible="{Binding HasLyric}">
        <TextBlock x:Name="LyricBox" Text="{Binding LyricText}" FontSize="13" LineHeight="22"
                   Opacity="0.92" TextWrapping="Wrap" TextAlignment="Center"
                   VerticalAlignment="Center" HorizontalAlignment="Stretch">
          <TextBlock.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}"/>
            </Transitions>
          </TextBlock.Transitions>
        </TextBlock>
      </Border>

      <!-- 无歌词时静默隐藏，不弹错误提示 -->
      <TextBlock Text="暂无歌词（本地无 .lrc 且在线未匹配到）" FontSize="11" Opacity="0.55"
                 TextAlignment="Center"
                 IsVisible="{Binding HasLyric, Converter={StaticResource InvBoolToVis}}"/>

      <!-- 本地客户端模式状态卡片：启动器当遥控器，播放由外部客户端负责 -->
      <Border IsVisible="{Binding IsLocalClient}" Padding="14,12" CornerRadius="8"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="本地客户端模式" FontWeight="Bold" FontSize="14"
                     Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock Text="启动器作为遥控器显示信息，播放与进度由客户端负责。"
                     FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBlock Text="{Binding ClientStatus}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock Text="{Binding ClientRunning}" FontSize="11" Opacity="0.85" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryForeground}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="选择程序" Command="{Binding BrowseClientCommand}" Classes="modal-btn"/>
            <Button Content="启动客户端" Command="{Binding LaunchClientCommand}"
                    IsEnabled="{Binding HasClientExe}" Classes="modal-btn primary"/>
            <Button Content="重新拉取歌词" Command="{Binding SyncClientTrackCommand}" Classes="modal-btn"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 音源专属操作 -->
      <StackPanel>
        <!-- 本地 -->
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
          <Button Content="加载音乐文件夹" Command="{Binding LoadLocalFolderCommand}"
                  Classes="modal-btn primary"/>
        </StackPanel>
        <!-- 在线音源：搜索 / 歌单 / 登录（对齐 WPF MusicPlayerView） -->
        <StackPanel Spacing="8" IsVisible="{Binding IsOnline, Converter={StaticResource BoolToVis}}">

          <!-- 搜索 + 登录入口 -->
          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="260" Text="{Binding OnlineKeyword}" Watermark="输入歌曲名搜索"
                       IsEnabled="{Binding OnlineIdle}"
                       Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                       BorderBrush="{DynamicResource InputBorder}"/>
              <Button Content="搜索" Command="{Binding SearchOnlineCommand}"
                      IsEnabled="{Binding OnlineIdle}" Classes="modal-btn primary"/>
              <!-- 「我的歌单 / 扫码登录」只有支持登录的数据源才有 -->
              <Button Content="我的歌单" Command="{Binding RefreshMyPlaylistsCommand}"
                      IsVisible="{Binding CanOnlineLogin}" Classes="modal-btn"/>
              <Button Content="扫码登录" Command="{Binding StartApiLoginCommand}"
                      IsVisible="{Binding CanOnlineLogin}" Classes="modal-btn"/>
              <Button Content="退出登录" Command="{Binding ApiLogoutCommand}"
                      IsVisible="{Binding IsOnlineLoggedIn}" Classes="modal-btn"/>
            </StackPanel>
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanOnlineLogin}">
            <TextBlock Text="账户：" VerticalAlignment="Center" Opacity="0.85"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBlock Text="{Binding ApiAccountLabel}" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryForeground}"/>
          </StackPanel>

          <!-- 我的歌单：空集合时 ItemsControl 自然不占高度 -->

          <ItemsControl ItemsSource="{Binding MyPlaylists}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.ImportPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" Margin="0,2,6,2" Padding="8,4"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.6"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 手填歌单 ID（部分数据源没有「搜歌单」能力） -->

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="240" Text="{Binding PlaylistIdInput}" Watermark="歌单 ID"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <Button Content="导入歌单" Command="{Binding ImportPlaylistCommand}" Classes="modal-btn"/>
          </StackPanel>

          <!-- 自定义直链：直接填在线播放地址 -->

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="320" Text="{Binding OnlineUrl}" Watermark="在线直链（直接播放链接）"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <Button Content="添加" Command="{Binding AddOnlineCommand}" Classes="modal-btn primary"/>
          </StackPanel>

          <TextBlock Text="{Binding OnlineStatus}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                     IsVisible="{Binding OnlineStatus, Converter={StaticResource NonEmptyToVis}}"
                     Foreground="{DynamicResource SecondaryForeground}"/>
        </StackPanel>
        <!-- MC 原声 -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsMcOst, Converter={StaticResource BoolToVis}}">
          <Button Content="扫描 MC 原声" Command="{Binding ScanMcOstCommand}"
                  Classes="modal-btn primary"/>
          <TextBlock Text="{Binding McOstStatus}" VerticalAlignment="Center" Opacity="0.9"
                     Foreground="{DynamicResource SecondaryForeground}"/>
        </StackPanel>
      </StackPanel>

      <!-- 列表 -->
      <!-- 本地 / 在线：统一播放列表 -->
      <ListBox ItemsSource="{Binding Tracks}"
               IsVisible="{Binding IsMcOst, Converter={StaticResource InvBoolToVis}}"
               Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
               BorderBrush="{DynamicResource InputBorder}" MaxHeight="320">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Display}" Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 在线搜索结果：点一条即点播（先换直链再加入播放列表） -->

      <StackPanel IsVisible="{Binding IsOnline, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="搜索结果" FontWeight="Bold" Margin="0,12,0,4"
                   Foreground="{DynamicResource PrimaryForeground}"/>
        <ListBox ItemsSource="{Binding OnlineResults}" MaxHeight="280"
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                 BorderBrush="{DynamicResource InputBorder}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.PlayOnlineTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"
                      Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.65"
                             Foreground="{DynamicResource SecondaryForeground}"/>
                  <!-- 来源厂家：聚合搜索下结果混着多家，不标出处用户不知道点的是哪家的歌 -->
                  <TextBlock Text="{Binding PlatformText}" FontSize="11" Opacity="0.65"
                             Foreground="{DynamicResource SecondaryForeground}"/>
                  <TextBlock Text="{Binding DurationText}" FontSize="11" Opacity="0.55"
                             Foreground="{DynamicResource SecondaryForeground}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- MC 原声：按分类分组 -->
      <ScrollViewer IsVisible="{Binding IsMcOst, Converter={StaticResource BoolToVis}}" MaxHeight="360">
        <ItemsControl ItemsSource="{Binding McOstGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,4,0,4" Opacity="0.85"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <ItemsControl ItemsSource="{Binding Tracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Title}"
                              Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"
                              Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </StackPanel>
  </ScrollViewer>
</UserControl>
