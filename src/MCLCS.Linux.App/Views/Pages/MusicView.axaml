<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.MusicView">
  <UserControl.Resources>
    <conv:BoolToVisibleConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <conv:PlayPauseGlyphConverter x:Key="PlayPauseGlyph"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.musicBtn">
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">

      <!-- 音源切换 -->
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="音源：" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
        <Button Content="本地文件夹" Command="{Binding SetSourceCommand}" CommandParameter="Local"
                Classes="modal-btn"/>
        <Button Content="在线流媒体" Command="{Binding SetSourceCommand}" CommandParameter="Online"
                Classes="modal-btn"/>
        <Button Content="MC 原声" Command="{Binding SetSourceCommand}" CommandParameter="McOst"
                Classes="modal-btn"/>
      </StackPanel>

      <!-- 当前曲目 + 传输控制 -->
      <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
              BorderThickness="1" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding CurrentTrackDisplay}" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock FontSize="11" Opacity="0.85" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource SecondaryForeground}"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="musicBtn" Command="{Binding PreviousCommand}" Content="⏮"/>
            <Button Classes="musicBtn" Command="{Binding PlayPauseCommand}"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0">
              <TextBlock Text="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}}" Foreground="White"/>
            </Button>
            <Button Classes="musicBtn" Command="{Binding NextCommand}" Content="⏭"/>
            <Button Classes="musicBtn" Command="{Binding SetModeCommand}" Content="🔁"
                    ToolTip.Tip="{Binding ModeText}"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="6">
              <TextBlock Text="🔊" VerticalAlignment="Center"/>
              <Slider Minimum="0" Maximum="100" Width="140" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Volume, Mode=OneWay, StringFormat='{}{0}%'}" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>
          </StackPanel>
          <ToggleSwitch IsChecked="{Binding AutoDuck}" Content="游戏内语音/音效时自动降低音乐音量"
                        HorizontalAlignment="Left" OffContent="" OnContent=""/>
        </StackPanel>
      </Border>

      <!-- 音源专属操作 -->
      <StackPanel>
        <!-- 本地 -->
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
          <Button Content="加载音乐文件夹" Command="{Binding LoadLocalFolderCommand}"
                  Classes="modal-btn primary"/>
        </StackPanel>
        <!-- 在线流媒体 -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOnline, Converter={StaticResource BoolToVis}}">
          <TextBox Text="{Binding OnlineUrl}" Width="320" Watermark="在线流媒体地址（直接播放链接）"
                   Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                   BorderBrush="{DynamicResource InputBorder}"/>
          <Button Content="添加" Command="{Binding AddOnlineCommand}" Classes="modal-btn primary"/>
          <TextBlock Text="预设：" VerticalAlignment="Center" Opacity="0.85" Foreground="{DynamicResource SecondaryForeground}"/>
          <ComboBox Width="240" ItemsSource="{Binding OnlinePresets}"
                    SelectedItem="{Binding OnlineUrl, Mode=TwoWay}"
                    Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"/>
        </StackPanel>
        <!-- MC 原声 -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsMcOst, Converter={StaticResource BoolToVis}}">
          <Button Content="扫描 MC 原声" Command="{Binding ScanMcOstCommand}"
                  Classes="modal-btn primary"/>
          <TextBlock Text="{Binding McOstStatus}" VerticalAlignment="Center" Opacity="0.9"
                     Foreground="{DynamicResource SecondaryForeground}"/>
        </StackPanel>
      </StackPanel>

      <!-- 列表 -->
      <!-- 本地 / 在线：统一播放列表 -->
      <ListBox ItemsSource="{Binding Tracks}"
               IsVisible="{Binding IsMcOst, Converter={StaticResource InvBoolToVis}}"
               Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
               BorderBrush="{DynamicResource InputBorder}" MaxHeight="320">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Display}" Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- MC 原声：按分类分组 -->
      <ScrollViewer IsVisible="{Binding IsMcOst, Converter={StaticResource BoolToVis}}" MaxHeight="360">
        <ItemsControl ItemsSource="{Binding McOstGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,4,0,4" Opacity="0.85"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <ItemsControl ItemsSource="{Binding Tracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Title}"
                              Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"
                              Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </StackPanel>
  </ScrollViewer>
</UserControl>
