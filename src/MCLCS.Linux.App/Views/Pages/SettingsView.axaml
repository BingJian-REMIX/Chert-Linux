<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MCLCS.Linux.App.Views.Pages.SettingsView">
  <Grid ColumnDefinitions="190,*">
    <ListBox x:Name="CategoryList"
             Grid.Column="0"
             Margin="6,10,6,10"
             SelectionChanged="CategoryList_SelectionChanged"
             Background="{DynamicResource WindowBackground}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="6,2"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ScrollViewer Grid.Column="1" Margin="16,12,18,18">
      <ContentControl x:Name="PageHost"/>
    </ScrollViewer>
  </Grid>
</UserControl>
