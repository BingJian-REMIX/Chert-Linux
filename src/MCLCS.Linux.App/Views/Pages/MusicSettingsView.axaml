<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.MusicSettingsView"
             x:DataType="vm:MusicSettingsViewModel">

  <UserControl.Resources>
    <conv:DataUrlToImageConverter x:Key="DataUrlToImage"/>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

      <!-- 页面标题（与其它设置子页一致） -->
      <TextBlock Text="音乐" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"
                 Foreground="{DynamicResource PrimaryForeground}"/>

      <!-- 播放偏好 -->
      <StackPanel Spacing="10">
        <WrapPanel>
          <ToggleSwitch IsChecked="{Binding MusicAutoDuck, Mode=TwoWay}"
                        Content="游戏启动时自动降低音乐音量"
                        Foreground="{DynamicResource PrimaryForeground}"/>
        </WrapPanel>
        <WrapPanel>
          <ToggleSwitch IsChecked="{Binding MusicResumeOnLaunch, Mode=TwoWay}"
                        Content="启动器启动时自动续播上次音乐"
                        Foreground="{DynamicResource PrimaryForeground}"/>
        </WrapPanel>
      </StackPanel>

      <!-- 本地客户端模式：把外部音乐客户端当遥控器 -->
      <Border Padding="12,10" CornerRadius="8"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="本地客户端模式" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock Text="启用后启动器不再输出音频，只作为遥控器显示曲目信息与歌词；播放由所选客户端负责。关闭时该入口在音乐页隐藏。"
                     FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource SecondaryForeground}"/>

          <!-- ① 总开关 -->
          <WrapPanel>
            <ToggleSwitch IsChecked="{Binding ClientModeEnabled, Mode=TwoWay}"
                          Content="启用本地客户端模式"
                          Foreground="{DynamicResource PrimaryForeground}"/>
          </WrapPanel>

          <StackPanel Spacing="10" Margin="0,10,0,0" IsEnabled="{Binding ClientModeEnabled}">
            <!-- ② 客户端程序 + 宽限期 -->
            <StackPanel Spacing="6">
              <TextBlock Text="客户端程序" FontSize="12"
                         Foreground="{DynamicResource PrimaryForeground}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="380" IsReadOnly="True" Text="{Binding ClientExePath, Mode=OneWay}"
                         Padding="6,4" VerticalAlignment="Center"/>
                <Button Content="选择程序" Command="{Binding BrowseClientCommand}"
                        VerticalAlignment="Center" Classes="modal-btn"/>
              </StackPanel>
              <TextBlock Text="未选择时无法启动客户端；启动器会记住上次选择。"
                         FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>

            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="客户端宽限期" VerticalAlignment="Center" Width="110"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <Slider Minimum="0" Maximum="30" Width="220"
                        Value="{Binding ClientGraceMinutes, Mode=TwoWay}"
                        IsEnabled="{Binding ClientModeEnabled}"
                        VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ClientGraceText}" VerticalAlignment="Center"
                           Opacity="0.8" FontSize="12"/>
              </StackPanel>
              <TextBlock Text="播放器切回本地/API 且客户端全程暂停超过该时长后，自动结束客户端进程。设为「不自动关闭」则永不结束。"
                         FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>

            <!-- ③ 歌词固定方式 -->
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="歌词固定方式" VerticalAlignment="Center" Width="110"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <ComboBox Width="220" SelectedIndex="{Binding LyricPinModeIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="仅当前行"/>
                  <ComboBoxItem Content="当前行 + 下一行"/>
                  <ComboBoxItem Content="上一行 + 当前行 + 下一行"/>
                </ComboBox>
              </StackPanel>
              <TextBlock Text="只影响歌词区显示几行，不影响歌词解析与查找。"
                         FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>

            <!-- ④ 客户端模式下仍用 API 获取歌词 -->
            <StackPanel Spacing="6">
              <WrapPanel>
                <ToggleSwitch IsChecked="{Binding ClientModeLyricEnabled, Mode=TwoWay}"
                              Content="客户端模式下仍用 API 获取歌词"
                              Foreground="{DynamicResource PrimaryForeground}"/>
              </WrapPanel>
              <TextBlock Text="关闭后进入客户端模式时隐藏歌词区（本地没有 .lrc 文件）。"
                         FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 在线音源：由启动器自己通过网络接口取流播放 -->

      <Border Padding="12,10" CornerRadius="8"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="在线音源" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock Text="由启动器自己通过网络接口取流播放。默认指到 Meting 公共实例；若要用「我的歌单」，请改用网易云 API 并填写自建服务地址。"
                     FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource SecondaryForeground}"/>

          <WrapPanel>
            <ToggleSwitch IsChecked="{Binding ApiEnabled, Mode=TwoWay}"
                          Content="启用在线音源"
                          Foreground="{DynamicResource PrimaryForeground}"/>
          </WrapPanel>

          <StackPanel Spacing="10" Margin="0,10,0,0" IsEnabled="{Binding ApiEnabled}">

            <!-- 数据源 -->
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="数据源" VerticalAlignment="Center" Width="110"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <ComboBox Width="260" SelectedIndex="{Binding ApiKindIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="Meting 聚合（免登录）"/>
                  <ComboBoxItem Content="网易云 API（支持扫码登录）"/>
                </ComboBox>
              </StackPanel>
            </StackPanel>

            <!-- 服务地址 -->
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="服务地址" VerticalAlignment="Center" Width="110"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <TextBox Width="300" Text="{Binding ApiBaseUrl}" Padding="6,4" VerticalAlignment="Center"/>
                <Button Content="恢复默认" Command="{Binding ApiRestoreDefaultUrlCommand}"
                        VerticalAlignment="Center" Classes="modal-btn"/>
              </StackPanel>
              <TextBlock Text="不含结尾斜杠。切换数据源时会重置为对应的默认地址。"
                         FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>

            <!-- 平台（仅 Meting 协议） -->
            <StackPanel Spacing="6" IsVisible="{Binding ApiPlatformVisible}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="平台" VerticalAlignment="Center" Width="110"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <ComboBox Width="180" SelectedIndex="{Binding ApiPlatformIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="网易云音乐"/>
                  <ComboBoxItem Content="QQ 音乐"/>
                  <ComboBoxItem Content="酷狗音乐"/>
                </ComboBox>
              </StackPanel>
            </StackPanel>

            <!-- 音质 -->
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="音质" VerticalAlignment="Center" Width="110"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <ComboBox Width="180" SelectedIndex="{Binding ApiQualityIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="标准 128k"/>
                  <ComboBoxItem Content="较高 192k"/>
                  <ComboBoxItem Content="极高 320k"/>
                  <ComboBoxItem Content="无损"/>
                </ComboBox>
              </StackPanel>
            </StackPanel>

            <!-- 登录状态 -->
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="登录状态" VerticalAlignment="Center" Width="110"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <TextBlock Text="{Binding ApiAccountLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="扫码登录" Command="{Binding ApiLoginCommand}"
                        IsVisible="{Binding ApiCanLogin}" Padding="10,5" Margin="0,0,8,0"
                        Classes="modal-btn accent"/>
                <Button Content="退出登录" Command="{Binding ApiLogoutCommand}"
                        IsVisible="{Binding ApiLoggedIn}" Padding="10,5" Classes="modal-btn"/>
              </StackPanel>
              <TextBlock Text="当前数据源不支持扫码登录" FontSize="11" Opacity="0.65"
                         IsVisible="{Binding !ApiCanLogin}"
                         Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>

            <!-- 二维码：服务端返回 data URL，由转换器解码 -->

            <Border Padding="12" CornerRadius="8" HorizontalAlignment="Left"
                    Background="{DynamicResource InputBackground}"
                    IsVisible="{Binding MusicPlayer.LoginPanelVisible}">
              <StackPanel Spacing="8">
                <Image Width="170" Height="170" Stretch="Uniform"
                       Source="{Binding MusicPlayer.LoginQrDataUrl, Converter={StaticResource DataUrlToImage}}"/>
                <TextBlock Text="{Binding MusicPlayer.LoginStatusText}" FontSize="11" Opacity="0.8"
                           TextAlignment="Center" MaxWidth="200" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <Button Content="取消" Command="{Binding ApiCancelLoginCommand}"
                        Padding="10,4" HorizontalAlignment="Center" Classes="modal-btn"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                 Foreground="{DynamicResource SecondaryForeground}"/>

      <!-- 无需「保存」按钮：所有项改一下即写盘并即时生效（与 WPF 一致） -->

    </StackPanel>
  </ScrollViewer>
</UserControl>
