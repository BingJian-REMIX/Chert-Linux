<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Source='settings.lang', Converter={StaticResource KeyToText}}"
                   FontWeight="Bold" FontSize="14"/>
        <ComboBox SelectedValue="{Binding SelectedLanguage}" SelectedValueBinding="{Binding Tag}" Width="180"
                  HorizontalAlignment="Left">
          <ComboBoxItem Content="{Binding LangChinese}" Tag="zh_CN"/>
          <ComboBoxItem Content="{Binding LangEnglish}" Tag="en_US"/>
        </ComboBox>
        <TextBlock Foreground="{DynamicResource SecondaryForeground}" FontSize="12" TextWrapping="Wrap"
                   Text="切换后即时生效，无需保存。"/>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="启动与界面" FontWeight="Bold" FontSize="14"/>
        <ToggleSwitch IsChecked="{Binding AnimationsEnabled}" Content="启用界面动画" HorizontalAlignment="Left"/>
        <ToggleSwitch IsChecked="{Binding FileWatchEnabled}" Content="{Binding Source='tool.filewatch', Converter={StaticResource KeyToText}}" HorizontalAlignment="Left"/>
        <ToggleSwitch IsChecked="{Binding AutoStartLauncher}" Content="登录系统后自动启动启动器" HorizontalAlignment="Left"/>
        <ToggleSwitch IsChecked="{Binding MinimizeToTray}" Content="关闭时最小化到系统托盘" HorizontalAlignment="Left"/>
        <ToggleSwitch IsChecked="{Binding HighDpiIcons}" Content="使用高清图标（HiDPI 适配）" HorizontalAlignment="Left"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="status" Text="{Binding Status}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="modal-btn primary" Content="保存" Command="{Binding SaveCommand}"
                HorizontalAlignment="Right"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
