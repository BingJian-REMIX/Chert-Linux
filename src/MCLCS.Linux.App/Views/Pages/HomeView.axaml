<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MCLCS.Linux.App.ViewModels"
             xmlns:core="using:MCLCS.Core.Recommend"
             x:Class="MCLCS.Linux.App.Views.Pages.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,22" Spacing="18">

      <TextBlock Text="主页 · 快速开始" FontSize="20" FontWeight="Bold"/>

      <!-- 快速启动 -->
      <Border Padding="16" Background="{DynamicResource CardBackground}" CornerRadius="10">
        <StackPanel Spacing="12">
          <TextBlock Text="启动游戏" FontWeight="SemiBold" FontSize="15"/>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <ComboBox Grid.Column="0" Margin="0,0,10,0" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" PlaceholderText="选择版本">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VersionListEntry">
                  <TextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Margin="0,0,10,0" Classes="modal-btn" Content="刷新" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}"/>
            <Button Grid.Column="2" Classes="modal-btn accent" Content="启动" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}"/>
          </Grid>

          <!-- 版本列表入口 / 版本设置（两个独立按键，置于下拉栏下方） -->
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="8">
            <Button Classes="modal-btn" Content="版本列表"
                    Click="OpenVersionList_Click"/>
            <Button Classes="modal-btn" Content="版本设置"
                    Command="{Binding OpenVersionSettingsCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 游玩统计 -->
      <StackPanel Spacing="8">
        <TextBlock Text="本年游玩" FontWeight="SemiBold" FontSize="15"/>
        <Grid ColumnDefinitions="*,*,*">
          <Border Grid.Column="0" Margin="0,0,12,0" Padding="14,10" Background="{DynamicResource CardBackground}" CornerRadius="8">
            <StackPanel Spacing="2">
              <TextBlock Text="最近版本" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
              <TextBlock Text="{Binding RecentVersionText}" FontWeight="SemiBold" FontSize="15"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Margin="0,0,12,0" Padding="14,10" Background="{DynamicResource CardBackground}" CornerRadius="8">
            <StackPanel Spacing="2">
              <TextBlock Text="本周时长" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
              <TextBlock Text="{Binding WeeklyPlayText}" FontWeight="SemiBold" FontSize="15"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Padding="14,10" Background="{DynamicResource CardBackground}" CornerRadius="8">
            <StackPanel Spacing="2">
              <TextBlock Text="本年崩溃" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
              <TextBlock Text="{Binding CrashCountText}" FontWeight="SemiBold" FontSize="15"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- 节日中心入口：仅在远程 config.json 命中当前节日时展示 -->
      <Border Padding="16" Background="{DynamicResource CardBackground}" CornerRadius="10"
              IsVisible="{Binding HasSeason}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SeasonText}" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Text="查看限时活动、节日服务器与内容推荐" FontSize="12"
                     Foreground="{DynamicResource SecondaryForeground}"/>
          <Button Classes="modal-btn accent" Content="进入节日中心" Click="OpenSeasonalHub_Click"
                  HorizontalAlignment="Left" Padding="14,6"/>
        </StackPanel>
      </Border>

      <!-- 年度报告入口：仅在首次启动周年日展示 -->
      <Border Padding="16" Background="{DynamicResource CardBackground}" CornerRadius="10"
              IsVisible="{Binding IsAnnualReportVisible}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="[年报]" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="年度报告" FontWeight="SemiBold" FontSize="15"/>
          </StackPanel>
          <TextBlock Text="{Binding AnnualReportHint}" FontSize="12" Foreground="{DynamicResource SecondaryForeground}"/>
          <Button Classes="modal-btn accent" Content="查看年度报告" Click="OpenAnnualReport_Click"
                  HorizontalAlignment="Left" Padding="14,6"/>
        </StackPanel>
      </Border>

      <!-- 智能推荐 -->
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="为你推荐" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="modal-btn" Content="查看全部" Padding="12,4"
                  Click="OpenRecommendation_Click" HorizontalAlignment="Right"/>
        </Grid>
        <TextBlock Text="{Binding RecommendStatus}" FontSize="12" Foreground="{DynamicResource SecondaryForeground}"/>
        <ItemsControl ItemsSource="{Binding Recommendations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:RecommendationItem">
              <Border Margin="0,0,0,8" Padding="12,10" Background="{DynamicResource CardBackground}" CornerRadius="8">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource CodeForeground}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
