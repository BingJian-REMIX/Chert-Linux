<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
        xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
        xmlns:views="clr-namespace:MCLCS.Linux.App.Views"
        x:Class="MCLCS.Linux.App.MainWindow"
        Title="朗希夏"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBackground}"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Opacity="0">

  <Window.Resources>
    <conv:HexToBrushConverter x:Key="HexToBrush"/>
    <conv:KeyToTextConverter x:Key="KeyToText"/>
    <conv:KindToBrushConverter x:Key="KindToBrush"/>
    <conv:TokenToBitmapConverter x:Key="TokenToBitmap"/>
    <conv:EqualsConverter x:Key="Equals"/>
    <conv:TabActiveBrushConverter x:Key="TabActiveBrush"/>
    <conv:BoolToColorConverter x:Key="BoolColor"/>
    <conv:TabTintConverter x:Key="TabTint"/>
    <conv:TabWidthConverter x:Key="TabWidth"/>
    <conv:TabBackgroundConverter x:Key="TabBg"/>
    <conv:TabMarginConverter x:Key="TabMargin"/>
    <conv:TabCornerConverter x:Key="TabCorner"/>
    <conv:TabUnderlineBrushConverter x:Key="TabUnderline"/>
    <conv:BoolToVisibleConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <conv:PlayPauseGlyphConverter x:Key="PlayPauseGlyph"/>
    <conv:ProgressToAngleConverter x:Key="ProgressToAngle"/>
  </Window.Resources>

  <Grid RowDefinitions="52,* 30">
    <!-- ===== 背景图片（设置 → 外观：背景图，铺满窗口、置于内容之下）===== -->
    <Image x:Name="BgImage" Grid.Row="0" Grid.RowSpan="3" Stretch="UniformToFill"
           IsVisible="False" ZIndex="0"/>

    <!-- ===== 标题栏（52px，背景跟随当前主标签色，对齐 WPF TitleBarBrush）===== -->
    <Grid x:Name="TitleBar" Grid.Row="0"
          Background="{Binding SelectedTab.Kind, Converter={StaticResource KindToBrush}}"
          PointerPressed="TitleBar_PointerPressed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="272"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="朗希夏" FontSize="17" FontWeight="Bold"
                 Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>

      <!-- 全局搜索 + 下载队列入口（占位，对齐 WPF 搜索栏 + 下载按钮）-->
      <Grid Grid.Column="1" Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" VerticalAlignment="Center" Padding="8,4" FontSize="12"
                 Background="#30FFFFFF" Foreground="White" CaretBrush="White"
                 BorderBrush="#40FFFFFF" BorderThickness="1" Watermark="{Binding SearchWatermark}"/>
        <Button x:Name="DownloadBtn" Grid.Column="1" Width="34" Height="28" Margin="6,0,0,0" Cursor="Hand"
                Background="#30FFFFFF" BorderThickness="0" Padding="0" ToolTip.Tip="下载队列" Click="DownloadBtn_Click">
          <Grid Width="24" Height="24">
            <Ellipse Width="20" Height="20" Stroke="#30FFFFFF" StrokeThickness="2.5"/>
            <Arc Width="20" Height="20" StartAngle="-90"
                 SweepAngle="{Binding DownloadProgress, Converter={StaticResource ProgressToAngle}}"
                 Stroke="#FFFFFF" StrokeThickness="2.5" StrokeLineCap="Round"/>
            <Image Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image.Source>
                <Binding Source="download" Converter="{StaticResource TokenToBitmap}"/>
              </Image.Source>
            </Image>
          </Grid>
        </Button>
      </Grid>

      <!-- 四色索引贴主标签：重叠 + 展开动画（对齐 WPF MainTabs 几何：选中/游戏页展开 132 显文字，其余折叠 56 色条；左压右叠放；200ms 过渡）-->
      <ItemsControl Grid.Column="2" ItemsSource="{Binding TabItems}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,8,0">
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter">
            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
            <Setter Property="Margin" Value="{Binding Margin}"/>
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Tag="{Binding Kind}" Click="Tab_Click"
                    PointerEntered="Tab_PointerEntered" PointerExited="Tab_PointerExited"
                    Width="{Binding IsExpanded, Converter={StaticResource TabWidth}}"
                    Height="40" Margin="0" Padding="0" BorderThickness="0"
                    CornerRadius="{Binding, Converter={StaticResource TabCorner}}"
                    Cursor="Hand">
              <Button.Background>
                <MultiBinding Converter="{StaticResource TabBg}">
                  <Binding Path="IsSelected"/>
                  <Binding Path="Kind"/>
                </MultiBinding>
              </Button.Background>
              <Button.Transitions>
                <Transitions>
                  <DoubleTransition Property="Width" Duration="{StaticResource MotionNormal}"/>
                  <BrushTransition Property="Background" Duration="{StaticResource MotionFast}"/>
                </Transitions>
              </Button.Transitions>
              <Grid>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                           Foreground="White" IsVisible="{Binding IsExpanded}"/>
                <Rectangle Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                           Fill="{Binding Kind, Converter={StaticResource TabUnderline}}"
                           IsVisible="{Binding IsSelected}"/>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 窗口控制（最小 / 最大化 / 关闭；语言与主题已移至设置页，对齐 WPF）-->
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Spacing="6">
        <Button x:Name="BtnMin" Width="36" Height="30" Background="Transparent"
                BorderThickness="0" Foreground="White" Click="BtnMin_Click">
          <Image Width="12" Height="12">
            <Image.Source>
              <Binding Source="minimize" Converter="{StaticResource TokenToBitmap}"/>
            </Image.Source>
          </Image>
        </Button>
        <Button x:Name="BtnMax" Width="36" Height="30" Background="Transparent"
                BorderThickness="0" Foreground="White" Click="BtnMax_Click">
          <Grid>
            <Rectangle x:Name="MaxIconNormal" Width="12" Height="12" Stroke="White" StrokeThickness="1.5"/>
            <Grid x:Name="MaxIconRestored" IsVisible="False">
              <Rectangle Width="12" Height="12" Stroke="White" StrokeThickness="1.5"/>
              <Rectangle Width="8" Height="8" Stroke="White" StrokeThickness="1.5" Margin="4,4,0,0"/>
            </Grid>
          </Grid>
        </Button>
        <Button x:Name="BtnClose" Width="36" Height="30"
                BorderThickness="0" Foreground="White" Click="BtnClose_Click">
          <Image Width="12" Height="12">
            <Image.Source>
              <Binding Source="close" Converter="{StaticResource TokenToBitmap}"/>
            </Image.Source>
          </Image>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== 主体 ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 可折叠图标侧边栏（56↔152，悬停展开；对齐 WPF SidebarRoot）-->
      <Border x:Name="SidebarRoot" Grid.Column="0" Width="56"
              Background="{DynamicResource ControlBackground}"
              BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlBorder}"
              IsVisible="{Binding HasSidebar}"
              PointerEntered="Sidebar_Enter" PointerExited="Sidebar_Leave">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="{StaticResource MotionNormal}"/>
          </Transitions>
        </Border.Transitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ListBox x:Name="SidebarList" ItemsSource="{Binding SidebarItems}"
                   Background="Transparent" BorderThickness="0"
                   SelectionChanged="Sidebar_SelectionChanged">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="6"/>
              </Style>
              <Style Selector="ListBoxItem:pointerover">
                <Setter Property="Background" Value="#1FFFFFFF"/>
              </Style>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Background" Value="#26FFFFFF"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Height="40" Margin="6,2">
                  <!-- 选中指示竖线：跟随「设置 → 外观 → 主题色」（SidebarIndicatorBrush，
                       由 App.ApplyAccentColor 写入）。此前用 KindToBrush 取当前主标签色，
                       改主题色时指示条不变（对齐 WPF 31e9124）。 -->
                  <Rectangle Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                             Fill="{DynamicResource SidebarIndicatorBrush}">
                    <Rectangle.IsVisible>
                      <MultiBinding Converter="{StaticResource Equals}">
                        <Binding Path="Id"/>
                        <Binding Path="DataContext.SelectedSidebarId"
                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                      </MultiBinding>
                    </Rectangle.IsVisible>
                  </Rectangle>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Width="18" Height="18" Source="{Binding Icon, Converter={StaticResource TokenToBitmap}}"/>
                    <TextBlock Text="{Binding Title, Converter={StaticResource KeyToText}}"
                               FontSize="13" Foreground="{DynamicResource SecondaryForeground}"
                               Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock.IsVisible>
                        <Binding Path="DataContext.SidebarExpanded"
                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                      </TextBlock.IsVisible>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Border>

      <!-- 内容宿主：顶部同色渐隐带，切页时整体淡入 + 上移（对齐设计稿 pageIn）-->
      <Border x:Name="ContentHost" Grid.Column="1"
              Background="{Binding SelectedTab.Kind, Converter={StaticResource TabTint}}">
        <Border.Transitions>
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionNormal}"/>
          </Transitions>
        </Border.Transitions>
        <Grid RowDefinitions="Auto,*">
          <!-- 页头：有侧栏时显示标题 / 描述（工具箱页不显示「分组」与介绍） -->
          <StackPanel Grid.Row="0" Spacing="4" Margin="18,18,18,0"
                      IsVisible="{Binding HasSidebar}">
            <TextBlock Text="{Binding PanelTitle}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForeground}"/>
            <TextBlock Text="{Binding PanelDescription}" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"
                       IsVisible="{Binding !IsToolboxTab}"/>
          </StackPanel>
          <!-- 页面宿主：按 SelectedTab / SelectedSidebarId 路由到具体功能页 -->
          <ContentControl x:Name="PageRegion" Grid.Row="1" Margin="0,12,0,0"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== 状态栏（30px，对齐 WPF StatusBar）===== -->
    <DockPanel Grid.Row="2" Background="{DynamicResource ControlBackground}"
               LastChildFill="False" Margin="8,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="14"
                  VerticalAlignment="Center">
        <TextBlock Text="{Binding JavaVersionText}"/>
        <TextBlock Text="{Binding InstalledCountText}"/>
        <TextBlock Text="{Binding RunningInstancesText}"/>
      </StackPanel>

      <!-- 音乐播放器迷你条（规格 2.3：状态栏迷你条可展开为完整列表） -->
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="14,0,0,0" Spacing="4"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasTrack, Source={x:Static vm:MusicPlayerViewModel.Instance}, Converter={StaticResource BoolToVis}}">
        <Button Width="26" Height="22" BorderThickness="0" Background="Transparent"
                Command="{Binding PlayPauseCommand, Source={x:Static vm:MusicPlayerViewModel.Instance}}"
                ToolTip.Tip="播放 / 暂停" VerticalAlignment="Center">
          <TextBlock Text="{Binding IsPlaying, Source={x:Static vm:MusicPlayerViewModel.Instance}, Converter={StaticResource PlayPauseGlyph}}"
                     Foreground="{DynamicResource StatusForeground}"/>
        </Button>
        <TextBlock Text="{Binding CurrentTrackDisplay, Source={x:Static vm:MusicPlayerViewModel.Instance}}"
                   VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource StatusForeground}"/>
        <Button x:Name="MusicExpandBtn" Width="24" Height="22" BorderThickness="0" Background="Transparent"
                Command="{Binding ExpandCommand, Source={x:Static vm:MusicPlayerViewModel.Instance}}"
                ToolTip.Tip="展开 / 收起播放列表" VerticalAlignment="Center">
          <TextBlock Text="▤" Foreground="{DynamicResource StatusForeground}"/>
        </Button>
      </StackPanel>

      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Spacing="6"
                  VerticalAlignment="Center">
        <Ellipse Width="8" Height="8" Fill="{Binding IsNetworkOk, Converter={StaticResource BoolColor}}"/>
        <TextBlock Text="{Binding NetworkStatusText}"/>
      </StackPanel>
    </DockPanel>

    <!-- 音乐播放列表弹出层（迷你条展开） -->
    <Popup Grid.Row="2" PlacementTarget="{Binding #MusicExpandBtn}" Placement="Top"
           IsOpen="{Binding Expanded, Source={x:Static vm:MusicPlayerViewModel.Instance}, Mode=OneWay}"
           IsLightDismissEnabled="True" Width="320" Height="300">
      <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
              BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid DataContext="{x:Static vm:MusicPlayerViewModel.Instance}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="播放列表" FontWeight="Bold" Foreground="{DynamicResource SecondaryForeground}"
                     Margin="2,0,0,6"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" SelectedItem="{Binding CurrentTrack, Mode=OneWay}"
                   Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
              </Style>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Popup>

    <!-- 全局弹层：模态对话框 + Toast（覆盖全窗，对齐设计稿 modalRoot / toasts）-->
    <views:ModalHost Grid.RowSpan="3" IsHitTestVisible="False"/>
    <views:ToastHost Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
  </Grid>
</Window>
