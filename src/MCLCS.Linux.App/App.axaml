<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <fluent:FluentTheme />

        <!-- 全局隐式控件样式：圆角 + 主题色描边悬停（对齐 WPF Controls.xaml 设计语言）-->
        <!-- 全局 TextBlock 兜底：未显式设置前景/字号的文字统一走主题主前景与基准字号（对齐 WPF 暗色文字可读性 + 字体缩放 bug #10）。
             显式设置 Foreground / FontSize 的控件不受影响（局部属性优先于样式）。-->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        </Style>

        <!-- 复选/单选/开关：内容文字同步主题主前景，避免 Fluent 默认色在工具页渐隐背景上亮度异常 -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- 关闭按钮：常态透明、悬停转危险红（对齐 WPF 标题栏关闭按钮）-->
        <Style Selector="Button#BtnClose">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button#BtnClose:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <!-- 玻璃卡片（对齐设计稿 .card / .card:hover，150ms）：
             悬停浮起 translateY(-6px) + 边框转主题色；阴影保持静止态。
             视觉属性由本 Style 统一提供，避免 XAML 局部值盖过 :pointerover 的覆盖。-->
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionFast}"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource MotionFast}"/>
                    <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionFast}"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-6px)"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHover}"/>
        </Style>

        <!-- 紧凑指标瓦片（对齐 WPF PerfView：圆角 6 / 内边距 12 / 实底控件色）-->
        <Style Selector="Border.tile">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        </Style>

        <!-- 模态按钮（对齐设计稿 .btn / .btn.primary / .btn.ghost）-->
        <Style Selector="Button.modal-btn">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.modal-btn:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.modal-btn.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.modal-btn.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        </Style>
        <Style Selector="Button.modal-btn.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        </Style>
        <Style Selector="Button.modal-btn.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.modal-btn.danger:pointerover">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>
        <!-- 模态关闭按钮 -->
        <Style Selector="Button.modal-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.modal-close:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
        </Style>
        <!-- Toast 关闭 / 操作按钮 -->
        <Style Selector="Button.toast-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toast-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 状态栏文本：允许换行并限高，避免长状态消息横向溢出卡片（Bug-8）-->
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </Application.Styles>

    <!-- 暗色配色板：对齐 MCLCS-WPF 的 DarkTheme.xaml / Palette.xaml -->
    <Application.Resources>
        <conv:KeyToTextConverter x:Key="KeyToText"/>
        <conv:TokenToBitmapConverter x:Key="TokenToBitmap"/>
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>
        <conv:CrashCategoryToBrushConverter x:Key="CrashCategoryToBrush"/>
        <conv:ConflictSeverityToBrushConverter x:Key="ConflictSeverityToBrush"/>
        <conv:SaveSeverityToBrushConverter x:Key="SaveSeverityToBrush"/>
        <conv:FileNameConverter x:Key="FileName"/>
        <conv:ListJoinConverter x:Key="ListJoin"/>
        <conv:CountToVisibleConverter x:Key="CountToVisible"/>
        <conv:BoolToVisibleConverter x:Key="BoolToVisible"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:BoolToBrushConverter x:Key="BoolToBrush"/>
        <conv:FileChangeKindToTextConverter x:Key="FileChangeKindToText"/>
        <conv:FileChangeKindToBrushConverter x:Key="FileChangeKindToBrush"/>
        <conv:AfkOpKindToTextConverter x:Key="AfkOpKindToText"/>
        <conv:AfkInstructionToTextConverter x:Key="AfkInstructionToText"/>
        <conv:NbtTagTypeToTextConverter x:Key="NbtTagTypeToText"/>
        <conv:OllamaStatusToTextConverter x:Key="OllamaStatusToText"/>
        <conv:OllamaStatusToBrushConverter x:Key="OllamaStatusBrush"/>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
        <conv:SourceToDetailTextConverter x:Key="SourceToDetailText"/>
        <conv:SourceNotMinecraftConverter x:Key="SourceNotMinecraft"/>
        <conv:StringEqualsConverter x:Key="StringEquals"/>
        <conv:StringNotEqualsConverter x:Key="StringNotEquals"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#0F1115"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#1A1D24"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#2A2F3A"/>
        <SolidColorBrush x:Key="ControlHoverBackground" Color="#252830"/>

        <SolidColorBrush x:Key="CardBackground" Color="#B31A1D24"/>
        <SolidColorBrush x:Key="CardBorderHover" Color="#3B82F6"/>
        <BoxShadows x:Key="CardShadow">0 2 10 0 #00000047</BoxShadows>

        <!-- 弹窗系统资源（对齐设计稿 scrim / modal / toast 阴影）-->
        <SolidColorBrush x:Key="ScrimBrush" Color="#00000080"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2B6FE0"/>
        <BoxShadows x:Key="ModalShadow">0 24 60 0 #00000080</BoxShadows>
        <BoxShadows x:Key="ToastShadow">0 8 24 0 #00000073</BoxShadows>

        <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryForeground" Color="#C8CDD6"/>
        <SolidColorBrush x:Key="StatusForeground" Color="#C8CDD6"/>

        <SolidColorBrush x:Key="CodeForeground" Color="#9cdcfe"/>
        <SolidColorBrush x:Key="WarningForeground" Color="#E67E22"/>
        <SolidColorBrush x:Key="SuccessForeground" Color="#27AE60"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>

        <SolidColorBrush x:Key="InputBackground" Color="#14161C"/>
        <SolidColorBrush x:Key="InputBorder" Color="#2A2F3A"/>
        <SolidColorBrush x:Key="InputFocusBorder" Color="#3B82F6"/>

        <SolidColorBrush x:Key="ProgressBackground" Color="#2A2F3A"/>

        <!-- ===== 字体缩放基准（对齐 WPF Controls.xaml BaseFontSize，bug #10） ===== -->
        <x:Double x:Key="BaseFontSize">13</x:Double>

        <!-- ===== 统一动画时长（全项目唯一定义处，禁止再散落硬编码 0:0:0.15 等）=====
             与 MotionFx.Fast / Normal / Slow 一一对应，改这里即全局生效。
             观测值：Fast=悬停/按下/淡入，Normal=页面/面板切换，Slow=首帧淡入/大范围过渡。 -->
        <x:TimeSpan x:Key="MotionFast">0:0:0.150</x:TimeSpan>
        <x:TimeSpan x:Key="MotionNormal">0:0:0.200</x:TimeSpan>
        <x:TimeSpan x:Key="MotionSlow">0:0:0.250</x:TimeSpan>

        <!-- ===== 语义前景/强调（补齐 WPF DarkTheme 缺失键） ===== -->
        <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2B6FE0"/>

        <!-- 按钮语义键（WPF Controls 有、Linux 缺；隐式 Button 样式已对齐外观） -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#3B82F6"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#2B6FE0"/>
        <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#3A3F4A"/>

        <!-- 输入前景（WPF 有、Linux 缺） -->
        <SolidColorBrush x:Key="InputForeground" Color="#E6E6E6"/>

        <!-- ListView（补齐 WPF DarkTheme 键） -->
        <SolidColorBrush x:Key="ListViewBackground" Color="#14161C"/>
        <SolidColorBrush x:Key="ListViewHeaderBackground" Color="#1E2128"/>
        <SolidColorBrush x:Key="ListViewBorder" Color="#2A2F3A"/>

        <!-- 进度条前景（WPF 有、Linux 缺） -->
        <SolidColorBrush x:Key="ProgressForeground" Color="#3B82F6"/>

        <!-- TabControl 基底（WPF DarkTheme 键，供原生 TabControl 主题引用） -->
        <SolidColorBrush x:Key="TabBackground" Color="#0F1115"/>
        <SolidColorBrush x:Key="TabItemBackground" Color="#1A1D24"/>
        <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#252830"/>
        <SolidColorBrush x:Key="TabItemHoverBackground" Color="#1E2128"/>

        <!-- 开关轨道关闭态（WPF Controls 用） -->
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#3A3F4A"/>

        <!-- 模态遮罩（WPF 名为 ModalScrimBrush，Linux 现有 ScrimBrush；补齐别名） -->
        <SolidColorBrush x:Key="ModalScrimBrush" Color="#80000000"/>

        <!-- ===== 四色索引贴调色板（对齐 WPF Palette.xaml，规格 1.2/2.4） =====
             每色四档：实色 / 暗化0.7 / 提亮1.12 / 下划线1.45。运行时可由 MainWindow 后台按当前主标签覆写。 -->
        <SolidColorBrush x:Key="TabGameBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="TabGameDimBrush" Color="#357B38"/>
        <SolidColorBrush x:Key="TabGameActiveBrush" Color="#55C45A"/>
        <SolidColorBrush x:Key="TabGameUnderlineBrush" Color="#6EFE74"/>
        <SolidColorBrush x:Key="TabDownloadBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="TabDownloadDimBrush" Color="#1769AA"/>
        <SolidColorBrush x:Key="TabDownloadActiveBrush" Color="#25A8FF"/>
        <SolidColorBrush x:Key="TabDownloadUnderlineBrush" Color="#30DAFF"/>
        <SolidColorBrush x:Key="TabToolboxBrush" Color="#FF9800"/>
        <SolidColorBrush x:Key="TabToolboxDimBrush" Color="#B36A00"/>
        <SolidColorBrush x:Key="TabToolboxActiveBrush" Color="#FFAA00"/>
        <SolidColorBrush x:Key="TabToolboxUnderlineBrush" Color="#FFDC00"/>
        <SolidColorBrush x:Key="TabSettingsBrush" Color="#607D8B"/>
        <SolidColorBrush x:Key="TabSettingsDimBrush" Color="#435861"/>
        <SolidColorBrush x:Key="TabSettingsActiveBrush" Color="#6C8C9C"/>
        <SolidColorBrush x:Key="TabSettingsUnderlineBrush" Color="#8BB5CA"/>
        <!-- 随当前主标签实时覆写的语义键 -->
        <SolidColorBrush x:Key="TitleBarBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="SidebarIndicatorBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="TabForegroundBrush" Color="#FFFFFF"/>

        <!-- 控件样式类已统一置于 Application.Styles（类选择器 + Classes= 应用） -->

    </Application.Resources>
</Application>
